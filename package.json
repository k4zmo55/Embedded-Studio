{
  "name": "embedded-studio",
  "displayName": "Embedded Studio",
  "description": "STM32 için görsel gömülü sistem tasarımı: komponent seçimi, otomatik pin/saat ataması, HAL veya bare-metal + FreeRTOS kod üretimi, canlı monitör ve debug.",
  "version": "0.6.12",
  "publisher": "mhmtakfseckin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/k4zmo55/Embedded-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/k4zmo55/Embedded-Studio/issues"
  },
  "homepage": "https://github.com/k4zmo55/Embedded-Studio#readme",
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#16324f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "stm32",
    "embedded",
    "firmware",
    "freertos",
    "cubemx",
    "pinout",
    "kicad",
    "hal",
    "openocd",
    "st-link"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "workspaceContains:embedded-studio.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "embeddedStudio.openDesigner",
        "title": "%command.openDesigner%",
        "category": "Embedded Studio",
        "icon": "$(circuit-board)"
      },
      {
        "command": "embeddedStudio.newProject",
        "title": "%command.newProject%",
        "category": "Embedded Studio"
      },
      {
        "command": "embeddedStudio.generateCode",
        "title": "%command.generateCode%",
        "category": "Embedded Studio"
      },
      {
        "command": "embeddedStudio.build",
        "title": "%command.build%",
        "category": "Embedded Studio",
        "icon": "$(tools)"
      },
      {
        "command": "embeddedStudio.flash",
        "title": "%command.flash%",
        "category": "Embedded Studio",
        "icon": "$(zap)"
      },
      {
        "command": "embeddedStudio.debug",
        "title": "%command.debug%",
        "category": "Embedded Studio",
        "icon": "$(debug-alt)"
      },
      {
        "command": "embeddedStudio.run",
        "title": "%command.run%",
        "category": "Embedded Studio",
        "icon": "$(play)"
      },
      {
        "command": "embeddedStudio.terminal",
        "title": "%command.terminal%",
        "category": "Embedded Studio",
        "icon": "$(terminal)"
      },
      {
        "command": "embeddedStudio.probe",
        "title": "%command.probe%",
        "category": "Embedded Studio",
        "icon": "$(plug)"
      },
      {
        "command": "embeddedStudio.flashFile",
        "title": "%command.flashFile%",
        "category": "Embedded Studio",
        "icon": "$(zap)"
      },
      {
        "command": "embeddedStudio.signImage",
        "title": "%command.signImage%",
        "category": "Embedded Studio",
        "icon": "$(verified)"
      },
      {
        "command": "embeddedStudio.debugLaunchJson",
        "title": "%command.debugLaunchJson%",
        "category": "Embedded Studio",
        "icon": "$(debug-configure)"
      },
      {
        "command": "embeddedStudio.debugReset",
        "title": "%command.debugReset%",
        "category": "Embedded Studio",
        "icon": "$(debug-restart)"
      },
      {
        "command": "embeddedStudio.disassembly",
        "title": "%command.disassembly%",
        "category": "Embedded Studio",
        "icon": "$(file-binary)"
      }
    ],
    "configuration": {
      "title": "Embedded Studio",
      "properties": {
        "embeddedStudio.language": {
          "type": "string",
          "enum": [
            "auto",
            "tr",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "Türkçe",
            "English"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "embeddedStudio.flash.confirm": {
          "type": "boolean",
          "default": false,
          "description": "%config.flashConfirm%"
        },
        "embeddedStudio.probe.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "%config.probeAutoDetect%"
        },
        "embeddedStudio.flash.tool": {
          "type": "string",
          "enum": [
            "auto",
            "openocd",
            "cubeprog"
          ],
          "enumDescriptions": [
            "%config.flashTool.auto%",
            "OpenOCD",
            "STM32CubeProgrammer (STM32_Programmer_CLI)"
          ],
          "default": "auto",
          "description": "%config.flashTool%"
        },
        "embeddedStudio.flash.erase": {
          "type": "string",
          "enum": [
            "sector",
            "full"
          ],
          "enumDescriptions": [
            "%config.flashErase.sector%",
            "%config.flashErase.full%"
          ],
          "default": "sector",
          "description": "%config.flashErase%"
        },
        "embeddedStudio.flash.verify": {
          "type": "boolean",
          "default": true,
          "description": "%config.flashVerify%"
        },
        "embeddedStudio.flash.connectUnderReset": {
          "type": "boolean",
          "default": false,
          "description": "%config.flashUnderReset%"
        },
        "embeddedStudio.flash.speedKHz": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 24000,
          "description": "%config.flashSpeed%"
        },
        "embeddedStudio.debug.server": {
          "type": "string",
          "enum": [
            "auto",
            "openocd",
            "stlink",
            "pyocd",
            "jlink"
          ],
          "enumDescriptions": [
            "%config.debugServer.auto%",
            "OpenOCD",
            "ST-LINK GDB server (STM32CubeIDE / STM32CubeCLT)",
            "pyOCD",
            "SEGGER J-Link GDB server"
          ],
          "default": "auto",
          "description": "%config.debugServer%"
        },
        "embeddedStudio.hiddenTabs": {
          "type": "object",
          "default": {},
          "properties": {
            "beginner": { "type": "array", "items": { "type": "string", "enum": ["design", "pinout", "clock", "monitor", "terminal", "debug", "programmer", "analyzer"] }, "uniqueItems": true },
            "pro": { "type": "array", "items": { "type": "string", "enum": ["design", "pinout", "clock", "monitor", "terminal", "debug", "programmer", "analyzer"] }, "uniqueItems": true }
          },
          "additionalProperties": false,
          "description": "%config.hiddenTabs%"
        }
      }
    },
    "keybindings": [
      {
        "command": "embeddedStudio.build",
        "key": "f7",
        "when": "embeddedStudio.projectOpen && !inDebugMode"
      },
      {
        "command": "embeddedStudio.flash",
        "key": "shift+f7",
        "when": "embeddedStudio.projectOpen && !inDebugMode"
      },
      {
        "command": "embeddedStudio.debug",
        "key": "f5",
        "when": "embeddedStudio.projectOpen && !inDebugMode"
      },
      {
        "command": "embeddedStudio.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "embeddedStudio.projectOpen && !inDebugMode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "embeddedStudio.build",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.flash",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.debug",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.run",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.terminal",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.probe",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.flashFile",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.signImage",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.debugLaunchJson",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.debugReset",
          "when": "embeddedStudio.projectOpen && debugType == 'cortex-debug'"
        },
        {
          "command": "embeddedStudio.disassembly",
          "when": "embeddedStudio.projectOpen"
        }
      ],
      "explorer/context": [
        {
          "command": "embeddedStudio.flashFile",
          "when": "embeddedStudio.projectOpen && resourceExtname =~ /^\\.(elf|hex|bin)$/",
          "group": "embeddedStudio"
        },
        {
          "command": "embeddedStudio.signImage",
          "when": "embeddedStudio.projectOpen && resourceExtname =~ /^\\.(elf|hex|bin)$/",
          "group": "embeddedStudio"
        }
      ],
      "debug/callstack/context": [
        {
          "command": "embeddedStudio.debugReset",
          "when": "debugType == 'cortex-debug'",
          "group": "embeddedStudio"
        }
      ]
    }
  }
}
