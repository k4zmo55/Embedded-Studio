{
  "name": "embedded-studio",
  "displayName": "Embedded Studio",
  "description": "STM32 için görsel gömülü sistem tasarımı: komponent seçimi, otomatik pin/saat ataması, HAL veya bare-metal + FreeRTOS kod üretimi, canlı monitör ve debug.",
  "version": "0.5.1",
  "publisher": "mhmtakfseckin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/k4zmo55/Embedded-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/k4zmo55/Embedded-Studio/issues"
  },
  "homepage": "https://github.com/k4zmo55/Embedded-Studio#readme",
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#16324f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "stm32",
    "embedded",
    "firmware",
    "freertos",
    "cubemx",
    "pinout",
    "kicad",
    "hal",
    "openocd",
    "st-link"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "workspaceContains:embedded-studio.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "embeddedStudio.openDesigner",
        "title": "%command.openDesigner%",
        "category": "Embedded Studio",
        "icon": "$(circuit-board)"
      },
      {
        "command": "embeddedStudio.newProject",
        "title": "%command.newProject%",
        "category": "Embedded Studio"
      },
      {
        "command": "embeddedStudio.generateCode",
        "title": "%command.generateCode%",
        "category": "Embedded Studio"
      },
      {
        "command": "embeddedStudio.build",
        "title": "%command.build%",
        "category": "Embedded Studio",
        "icon": "$(tools)"
      },
      {
        "command": "embeddedStudio.flash",
        "title": "%command.flash%",
        "category": "Embedded Studio",
        "icon": "$(zap)"
      },
      {
        "command": "embeddedStudio.debug",
        "title": "%command.debug%",
        "category": "Embedded Studio",
        "icon": "$(debug-alt)"
      },
      {
        "command": "embeddedStudio.run",
        "title": "%command.run%",
        "category": "Embedded Studio",
        "icon": "$(play)"
      },
      {
        "command": "embeddedStudio.terminal",
        "title": "%command.terminal%",
        "category": "Embedded Studio",
        "icon": "$(terminal)"
      },
      {
        "command": "embeddedStudio.probe",
        "title": "%command.probe%",
        "category": "Embedded Studio",
        "icon": "$(plug)"
      }
    ],
    "configuration": {
      "title": "Embedded Studio",
      "properties": {
        "embeddedStudio.language": {
          "type": "string",
          "enum": [
            "auto",
            "tr",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "Türkçe",
            "English"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "embeddedStudio.flash.confirm": {
          "type": "boolean",
          "default": false,
          "description": "%config.flashConfirm%"
        }
      }
    },
    "keybindings": [
      {
        "command": "embeddedStudio.build",
        "key": "f7",
        "when": "embeddedStudio.projectOpen && !inDebugMode"
      },
      {
        "command": "embeddedStudio.flash",
        "key": "shift+f7",
        "when": "embeddedStudio.projectOpen && !inDebugMode"
      },
      {
        "command": "embeddedStudio.debug",
        "key": "f5",
        "when": "embeddedStudio.projectOpen && !inDebugMode"
      },
      {
        "command": "embeddedStudio.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "embeddedStudio.projectOpen && !inDebugMode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "embeddedStudio.build",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.flash",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.debug",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.run",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.terminal",
          "when": "embeddedStudio.projectOpen"
        },
        {
          "command": "embeddedStudio.probe",
          "when": "embeddedStudio.projectOpen"
        }
      ]
    }
  }
}
